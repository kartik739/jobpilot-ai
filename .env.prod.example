# ─── Production Environment Variables ─────────────────────────────────────────
# Copy this file to .env.prod and fill in all <placeholder> values before
# deploying.  Never commit .env.prod to version control.
#
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file .env.prod up -d

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=jobpilot

# ─── Security ─────────────────────────────────────────────────────────────────
# 32-byte base64-encoded key — generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=<32-byte-base64-encoded-key>

# Strong random secret — generate with:
#   openssl rand -hex 64
JWT_SECRET=<strong-random-secret>

# ─── GlitchTip (error tracking) ───────────────────────────────────────────────
# Strong random key — generate with:
#   openssl rand -hex 32
GLITCHTIP_SECRET_KEY=<strong-random-key>

# DSN for the in-stack GlitchTip instance (adjust project ID as needed)
GLITCHTIP_DSN=http://public-key@glitchtip:8000/1

# Public URL GlitchTip will use to build links in emails / UI
GLITCHTIP_DOMAIN=https://<your-domain>

# SMTP transport for GlitchTip outbound email
# Format: smtp://user:pass@host:port  (use smtps:// for implicit TLS on 465)
GLITCHTIP_EMAIL_URL=smtp://user:pass@smtp.example.com:587

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=<strong-password>

# ─── Domain & URLs ────────────────────────────────────────────────────────────
# Bare domain (no scheme) — used by nginx server_name and frontend env vars
DOMAIN=yourdomain.com

NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_WS_URL=wss://yourdomain.com/ws

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one provider and supply the corresponding API key.
LLM_PROVIDER=ollama
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
