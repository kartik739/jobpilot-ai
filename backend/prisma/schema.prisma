// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Gmail OAuth tokens (stored encrypted via AES-256-GCM)
  gmailAccessToken  String?   @map("gmail_access_token")
  gmailRefreshToken String?   @map("gmail_refresh_token")
  gmailTokenExpiry  DateTime? @map("gmail_token_expiry")
  // Whether the Google Calendar scope was granted during Gmail OAuth
  gmailCalendarScope Boolean @default(false) @map("gmail_calendar_scope")

  profile           Profile?
  resumeVersions    ResumeVersion[]
  jobMatches        JobMatch[]
  applications      ApplicationRecord[]
  agentTasks        AgentTask[]
  notifications     Notification[]
  jobSourceConfigs  JobSourceConfig[]
  reusableAnswers   ReusableAnswer[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Profile
// ─────────────────────────────────────────────

model Profile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  // Personal Information
  fullName  String  @map("full_name")
  email     String
  phone     String? // stored encrypted (AES-256-GCM)
  location  String

  linkedinUrl   String? @map("linkedin_url")
  githubUrl     String? @map("github_url")
  portfolioUrl  String? @map("portfolio_url")
  websiteUrl    String? @map("website_url")

  // Work Authorization
  workAuthorization   String[] @map("work_authorization")
  requiresSponsorship Boolean  @default(false) @map("requires_sponsorship")
  noticePeriod        Int      @default(0) @map("notice_period") // days

  // Job Preferences (stored as JSON)
  remotePreference      String   @default("flexible") @map("remote_preference")
  targetRoles           String[] @map("target_roles")
  preferredLocations    String[] @map("preferred_locations")
  salaryMin             String?  @map("salary_min") // stored encrypted
  salaryMax             String?  @map("salary_max") // stored encrypted
  currency              String   @default("USD")
  employmentTypes       String[] @map("employment_types")
  excludedCompanies     String[] @map("excluded_companies")
  preferredCompanies    String[] @map("preferred_companies")
  targetIndustries      String[] @map("target_industries")
  targetCompanySizes    String[] @map("target_company_sizes")
  dailyApplyLimit       Int      @default(10) @map("daily_apply_limit")
  autoPauseEnabled      Boolean  @default(true) @map("auto_pause_enabled")
  coverLetterReviewMode String   @default("auto") @map("cover_letter_review_mode")

  // Portal credentials (stored encrypted)
  portalCredentials String? @map("portal_credentials") // stored encrypted

  // Metadata
  profileCompleteness Int      @default(0) @map("profile_completeness")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences WorkExperience[]
  educations      Education[]
  projects        Project[]
  skills          Skill[]
  certifications  Certification[]

  @@map("profiles")
}

model WorkExperience {
  id          String   @id @default(cuid())
  profileId   String   @map("profile_id")
  company     String
  title       String
  location    String?
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  isCurrent   Boolean  @default(false) @map("is_current")
  description String?
  bullets     String[]
  skills      String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model Education {
  id           String    @id @default(cuid())
  profileId    String    @map("profile_id")
  institution  String
  degree       String
  field        String?
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  gpa          Float?
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model Project {
  id          String   @id @default(cuid())
  profileId   String   @map("profile_id")
  name        String
  description String?
  url         String?
  repoUrl     String?
  skills      String[]
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isCurrent   Boolean  @default(false) @map("is_current")
  highlights  String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Skill {
  id          String   @id @default(cuid())
  profileId   String   @map("profile_id")
  name        String
  category    String?
  proficiency String?  // beginner | intermediate | advanced | expert
  yearsOfExp  Float?   @map("years_of_exp")
  createdAt   DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Certification {
  id            String    @id @default(cuid())
  profileId     String    @map("profile_id")
  name          String
  issuer        String?
  issueDate     DateTime? @map("issue_date")
  expiryDate    DateTime? @map("expiry_date")
  credentialId  String?   @map("credential_id")
  credentialUrl String?   @map("credential_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

// ─────────────────────────────────────────────
// Resume Versions
// ─────────────────────────────────────────────

model ResumeVersion {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  name           String
  specialization String    // backend | frontend | fullstack | devops | cloud | ai_ml | mobile | data | general
  fileUrl        String    @map("file_url")
  fileHash       String    @map("file_hash")
  isDefault      Boolean   @default(false) @map("is_default")
  usageCount     Int       @default(0) @map("usage_count")
  successCount   Int       @default(0) @map("success_count")
  lastUsedAt     DateTime? @map("last_used_at")
  successRate    Float?    @map("success_rate")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications ApplicationRecord[]

  @@map("resume_versions")
}

// ─────────────────────────────────────────────
// Job Postings
// ─────────────────────────────────────────────

model JobPosting {
  id          String  @id @default(cuid())
  externalId  String? @map("external_id")
  sourceUrl   String  @map("source_url")
  platform    String
  fingerprint String  @unique

  // Extracted fields
  company         String
  title           String
  description     String
  descriptionHtml String?  @map("description_html")
  requiredSkills  String[] @map("required_skills")
  preferredSkills String[] @map("preferred_skills")
  yearsExperienceMin Int?  @map("years_experience_min")
  yearsExperienceMax Int?  @map("years_experience_max")
  location        String[]
  isRemote        Boolean  @default(false) @map("is_remote")
  isHybrid        Boolean  @default(false) @map("is_hybrid")
  salaryMin       Float?   @map("salary_min")
  salaryMax       Float?   @map("salary_max")
  currency        String?
  employmentType  String?  @map("employment_type")
  visaRequirements String[] @map("visa_requirements")
  applicationDeadline DateTime? @map("application_deadline")
  applicationUrl  String   @map("application_url")
  atsType         String?  @map("ats_type")

  // Processing metadata
  discoveredAt DateTime  @default(now()) @map("discovered_at")
  parsedAt     DateTime? @map("parsed_at")

  // pgvector embedding (384-dim, requires vector extension)
  embedding Unsupported("vector(384)")?

  rawData Json @map("raw_data")

  // 'new' | 'parsed' | 'ranked' | 'applied' | 'expired' | 'skipped' | 'parse_failed' | 'embedding_pending'
  status String @default("new")

  matches      JobMatch[]
  applications ApplicationRecord[]

  @@map("job_postings")
}

// ─────────────────────────────────────────────
// Job Matching
// ─────────────────────────────────────────────

model JobMatch {
  id           String @id @default(cuid())
  userId       String @map("user_id")
  jobPostingId String @map("job_posting_id")

  overall             Float
  skillMatch          Float   @map("skill_match")
  experienceMatch     Float   @map("experience_match")
  locationMatch       Float   @map("location_match")
  salaryMatch         Float   @map("salary_match")
  technologyMatch     Float   @map("technology_match")
  workAuthMatch       Boolean @map("work_auth_match")
  successProbability  Float   @map("success_probability")
  disqualifiers       Json    @map("disqualifiers")

  createdAt DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostingId])
  @@map("job_matches")
}

// ─────────────────────────────────────────────
// Applications
// ─────────────────────────────────────────────

model ApplicationRecord {
  id           String @id @default(cuid())
  userId       String @map("user_id")
  jobPostingId String @map("job_posting_id")

  appliedAt            DateTime @map("applied_at")
  source               String
  applicationUrl       String
  resumeVersionId      String   @map("resume_version_id")
  coverLetterPath      String?  @map("cover_letter_path")

  // Status tracking
  status               String   @default("draft")

  // Automation metadata
  automationSessionId  String?
  screenshotPaths      String[]
  confirmationNumber   String?  @map("confirmation_number")
  formAnswersSnapshot  Json
  fingerprint          String

  // Results
  rejectionReason      String?
  notes                String   @default("")
  matchScoreSnapshot   Json

  // Calendar integration (Requirements 17.2–17.6)
  calendarEventId      String?
  interviewDate        DateTime?
  interviewDuration    Int?      // minutes; defaults to 60 when not extractable (Req 17.3)
  interviewFormat      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting    JobPosting     @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion  @relation(fields: [resumeVersionId], references: [id])
  transitions   StatusTransition[]
  prepSheet     InterviewPrepSheet?

  @@unique([userId, fingerprint])
  @@map("application_records")
}

model StatusTransition {
  id                  String   @id @default(cuid())
  applicationRecordId String   @map("application_id")
  from                String   @map("from_status")
  to                  String   @map("to_status")
  triggeredBy         String   @map("triggered_by") // 'user' | 'email_monitor' | 'automation'
  timestamp           DateTime @default(now()) @map("created_at")
  note                String?

  application ApplicationRecord @relation(fields: [applicationRecordId], references: [id], onDelete: Cascade)

  @@map("status_transitions")
}

// ─────────────────────────────────────────────
// Agent Tasks
// ─────────────────────────────────────────────

model AgentTask {
  id          String    @id @default(cuid())
  type        String
  userId      String    @map("user_id")
  payload     Json
  priority    String    @default("normal") // critical | high | normal | low
  status      String    @default("queued") // queued | processing | completed | failed | retrying
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_tasks")
}

// ─────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────

model Notification {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  type     String
  title    String
  body     String
  metadata Json
  isRead   Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  readAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─────────────────────────────────────────────
// Job Source Configuration
// ─────────────────────────────────────────────

model JobSourceConfig {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  platform String
  enabled  Boolean @default(true) @map("is_active")
  config   Json    @map("search_params")

  lastRunAt       DateTime? @map("last_run_at")
  lastRunStatus   String    @default("never_run") // success | error | rate_limited | never_run
  lastRunJobsFound Int      @default(0)
  errorMessage    String?
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("job_source_configs")
}

// ─────────────────────────────────────────────
// LLM Cache
// ─────────────────────────────────────────────

model LlmCache {
  id          String    @id @default(cuid())
  promptHash  String    @unique @map("prompt_hash")
  response    String
  model       String
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  @@map("llm_cache")
}

// ─────────────────────────────────────────────
// Interview Prep
// ─────────────────────────────────────────────

model InterviewPrepSheet {
  id            String @id @default(cuid())
  applicationId String @unique @map("application_id")

  behavioralQuestions Json
  technicalQuestions  Json
  companySummary      String
  roleSpecificTips    Json
  generatedAt         DateTime @default(now()) @map("created_at")

  application ApplicationRecord @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("interview_prep_sheets")
}

// ─────────────────────────────────────────────
// Reusable Screening Answers
// ─────────────────────────────────────────────

model ReusableAnswer {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  questionType String
  answer       String
  usageCount   Int       @default(0) @map("usage_count")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionType])
  @@map("reusable_answers")
}
