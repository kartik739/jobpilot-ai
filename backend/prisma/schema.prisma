// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile           Profile?
  resumeVersions    ResumeVersion[]
  jobMatches        JobMatch[]
  applications      ApplicationRecord[]
  agentTasks        AgentTask[]
  notifications     Notification[]
  jobSourceConfigs  JobSourceConfig[]
  reusableAnswers   ReusableAnswer[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Profile
// ─────────────────────────────────────────────

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  // Personal Information
  fullName  String
  email     String
  phone     String? // stored encrypted (AES-256-GCM)
  location  String

  linkedinUrl   String?
  githubUrl     String?
  portfolioUrl  String?
  websiteUrl    String?

  // Work Authorization
  workAuthorization  String[]
  requiresSponsorship Boolean @default(false)
  noticePeriod        Int     @default(0) // days

  // Job Preferences (stored as JSON)
  remotePreference      String  @default("flexible")
  targetRoles           String[]
  preferredLocations    String[]
  salaryMin             String? // stored encrypted
  salaryMax             String? // stored encrypted
  currency              String  @default("USD")
  employmentTypes       String[]
  excludedCompanies     String[]
  preferredCompanies    String[]
  targetIndustries      String[]
  targetCompanySizes    String[]
  dailyApplyLimit       Int     @default(10)
  autoPauseEnabled      Boolean @default(true)
  coverLetterReviewMode String  @default("auto")

  // Portal credentials (stored encrypted)
  portalCredentials String? // stored encrypted

  // Metadata
  profileCompleteness Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences WorkExperience[]
  educations      Education[]
  projects        Project[]
  skills          Skill[]
  certifications  Certification[]

  @@map("profiles")
}

model WorkExperience {
  id          String   @id @default(cuid())
  profileId   String
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean  @default(false)
  description String?
  bullets     String[]
  skills      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model Education {
  id           String    @id @default(cuid())
  profileId    String
  institution  String
  degree       String
  field        String?
  startDate    DateTime
  endDate      DateTime?
  gpa          Float?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  description String?
  url         String?
  repoUrl     String?
  skills      String[]
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean  @default(false)
  highlights  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Skill {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  category    String?
  proficiency String?  // beginner | intermediate | advanced | expert
  yearsOfExp  Float?
  createdAt   DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Certification {
  id           String    @id @default(cuid())
  profileId    String
  name         String
  issuer       String?
  issueDate    DateTime?
  expiryDate   DateTime?
  credentialId String?
  credentialUrl String?
  createdAt    DateTime  @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

// ─────────────────────────────────────────────
// Resume Versions
// ─────────────────────────────────────────────

model ResumeVersion {
  id             String    @id @default(cuid())
  userId         String
  name           String
  specialization String    // backend | frontend | fullstack | devops | cloud | ai_ml | mobile | data | general
  fileUrl        String
  fileHash       String
  isDefault      Boolean   @default(false)
  usageCount     Int       @default(0)
  lastUsedAt     DateTime?
  successRate    Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications ApplicationRecord[]

  @@map("resume_versions")
}

// ─────────────────────────────────────────────
// Job Postings
// ─────────────────────────────────────────────

model JobPosting {
  id          String  @id @default(cuid())
  externalId  String?
  sourceUrl   String
  platform    String
  fingerprint String  @unique

  // Extracted fields
  company         String
  title           String
  description     String
  descriptionHtml String?
  requiredSkills  String[]
  preferredSkills String[]
  yearsExperienceMin Int?
  yearsExperienceMax Int?
  location        String[]
  isRemote        Boolean @default(false)
  isHybrid        Boolean @default(false)
  salaryMin       Float?
  salaryMax       Float?
  currency        String?
  employmentType  String?
  visaRequirements String[]
  applicationDeadline DateTime?
  applicationUrl  String
  atsType         String?

  // Processing metadata
  discoveredAt DateTime  @default(now())
  parsedAt     DateTime?

  // pgvector embedding (384-dim, requires vector extension)
  embedding Unsupported("vector(384)")?

  rawData Json

  // 'new' | 'parsed' | 'ranked' | 'applied' | 'expired' | 'skipped' | 'parse_failed' | 'embedding_pending'
  status String @default("new")

  matches      JobMatch[]
  applications ApplicationRecord[]

  @@map("job_postings")
}

// ─────────────────────────────────────────────
// Job Matching
// ─────────────────────────────────────────────

model JobMatch {
  id           String @id @default(cuid())
  userId       String
  jobPostingId String

  overall             Float
  skillMatch          Float
  experienceMatch     Float
  locationMatch       Float
  salaryMatch         Float
  technologyMatch     Float
  workAuthMatch       Boolean
  successProbability  Float
  disqualifiers       Json

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostingId])
  @@map("job_matches")
}

// ─────────────────────────────────────────────
// Applications
// ─────────────────────────────────────────────

model ApplicationRecord {
  id           String @id @default(cuid())
  userId       String
  jobPostingId String

  appliedAt            DateTime
  source               String
  applicationUrl       String
  resumeVersionId      String
  coverLetterPath      String?

  // Status tracking
  status               String   @default("draft")

  // Automation metadata
  automationSessionId  String?
  screenshotPaths      String[]
  confirmationNumber   String?
  formAnswersSnapshot  Json
  fingerprint          String

  // Results
  rejectionReason      String?
  notes                String   @default("")
  matchScoreSnapshot   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting    JobPosting     @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion  @relation(fields: [resumeVersionId], references: [id])
  transitions   StatusTransition[]
  prepSheet     InterviewPrepSheet?

  @@unique([userId, fingerprint])
  @@map("application_records")
}

model StatusTransition {
  id                  String   @id @default(cuid())
  applicationRecordId String
  from                String
  to                  String
  triggeredBy         String   // 'user' | 'email_monitor' | 'automation'
  timestamp           DateTime @default(now())
  note                String?

  application ApplicationRecord @relation(fields: [applicationRecordId], references: [id], onDelete: Cascade)

  @@map("status_transitions")
}

// ─────────────────────────────────────────────
// Agent Tasks
// ─────────────────────────────────────────────

model AgentTask {
  id          String    @id @default(cuid())
  type        String
  userId      String
  payload     Json
  priority    String    @default("normal") // critical | high | normal | low
  status      String    @default("queued") // queued | processing | completed | failed | retrying
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_tasks")
}

// ─────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────

model Notification {
  id       String  @id @default(cuid())
  userId   String
  type     String
  title    String
  body     String
  metadata Json
  isRead   Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─────────────────────────────────────────────
// Job Source Configuration
// ─────────────────────────────────────────────

model JobSourceConfig {
  id       String  @id @default(cuid())
  userId   String
  platform String
  enabled  Boolean @default(true)
  config   Json

  lastRunAt       DateTime?
  lastRunStatus   String    @default("never_run") // success | error | rate_limited | never_run
  lastRunJobsFound Int      @default(0)
  errorMessage    String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("job_source_configs")
}

// ─────────────────────────────────────────────
// LLM Cache
// ─────────────────────────────────────────────

model LlmCache {
  id          String    @id @default(cuid())
  promptHash  String    @unique
  response    String
  model       String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@map("llm_cache")
}

// ─────────────────────────────────────────────
// Interview Prep
// ─────────────────────────────────────────────

model InterviewPrepSheet {
  id            String @id @default(cuid())
  applicationId String @unique

  behavioralQuestions Json
  technicalQuestions  Json
  companySummary      String
  roleSpecificTips    Json
  generatedAt         DateTime @default(now())

  application ApplicationRecord @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("interview_prep_sheets")
}

// ─────────────────────────────────────────────
// Reusable Screening Answers
// ─────────────────────────────────────────────

model ReusableAnswer {
  id           String    @id @default(cuid())
  userId       String
  questionType String
  answer       String
  usageCount   Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionType])
  @@map("reusable_answers")
}
